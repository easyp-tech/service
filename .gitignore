# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
main
easyp
epctl
plugins/

# Test binary, built with `go test -c`
*.test

# Go workspace file
go.work

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Dependency directories
vendor/

# Generated protobuf files are committed for client usage
# api/**/*.pb.go
# api/**/*_grpc.pb.go

# Test generated files
test/generated/

# EasyP generated files
easyp.lock
.kiro/

# Serena tool workspace: local project config and cache.
.serena/
/easyp-svc
.tmp/

# Development TLS material generated by `task certs`
certs/

# Plugin caches the dev stack bind-mounts, one per tier. Not covered by the
# plugins/ rule above, which matches that name exactly.
deploy/plugins-community/
deploy/plugins-enterprise/

# Whatever the compose stack reads for secrets. deploy/.env.example and
# deploy/.env.dev.example are the committed templates; the real ones are not.
deploy/.env
deploy/.env.dev
# Carries the address Let's Encrypt writes to, which belongs to a deployment
# rather than to the repository. Copied from the .example beside it.
deploy/observability/traefik/traefik.public.yml


# Claude Code session data and worktrees
.claude/

# Agent tooling that lives beside the code without being part of it. The skills
# were removed from the repository in b356528; the directory stayed on disk, and
# an untracked directory that nothing ignores is one `git add -A` away from
# coming back — which it did, twice, into commits about other things.
# .aiforopenide/sessions/ is worse than noise: it holds transcripts.
.agents/
.aiforopenide/

# Secrets, by shape rather than by name. Every rule above names a path that had
# already gone wrong once; these catch the next one. A live S3 key pair reached
# a public repository through a file nobody thought to list, and git history
# does not forget.
*.pem
*.key
*.p12
*.pfx
.env
.env.*
!.env.example
!*.env.example
id_rsa*
id_ed25519*

# goreleaser output. Left untracked it fails the second goreleaser call in the
# release pipeline: the build pass writes here, and the publish pass refuses a
# dirty tree.
dist/
