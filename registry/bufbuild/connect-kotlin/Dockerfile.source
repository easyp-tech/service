# syntax=docker/dockerfile:1.22
# Build protoc-gen-connect-kotlin from source for early releases without a
# published Maven/GitHub jar (v0.1.1, v0.1.2).
FROM eclipse-temurin:17-jdk-jammy AS build
ARG VERSION

# Long timeouts: first-time Gradle wrapper download is large and flaky.
ENV GRADLE_OPTS="-Dorg.gradle.internal.http.connectionTimeout=600000 -Dorg.gradle.internal.http.socketTimeout=600000" \
    GRADLE_USER_HOME=/root/.gradle

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN git clone --depth 1 --branch ${VERSION} https://github.com/connectrpc/connect-kotlin.git .

# Fat jar with Main-Class is produced by the module's custom jar task.
RUN ./gradlew --no-daemon --stacktrace :protoc-gen-connect-kotlin:jar \
 && JAR=$(find protoc-gen-connect-kotlin/build/libs -name 'protoc-gen-connect-kotlin*.jar' ! -name '*-sources.jar' ! -name '*-javadoc.jar' | head -1) \
 && test -n "$JAR" \
 && cp "$JAR" /tmp/protoc-gen-connect-kotlin.jar

FROM maven:3.9.11-eclipse-temurin-21 AS maven-deps
ARG VERSION
COPY pom.xml /tmp/pom.xml
RUN cd /tmp && mvn -f pom.xml dependency:go-offline

FROM gcr.io/distroless/java17-debian11
ARG VERSION
WORKDIR /app
COPY --from=build /tmp/protoc-gen-connect-kotlin.jar /app/protoc-gen-connect-kotlin.jar
COPY --from=maven-deps /root/.m2/repository /maven-repository
COPY --chmod=0755 <<"EOF" /plugin
#!/bin/sh
# Paths are relative to this script: the service runs the bundle from its
# plugins directory, not from the image it was built in.
DIR=${0%/*}
for JAVA in "$DIR"/usr/lib/jvm/*/bin/java; do exec "$JAVA" -jar "$DIR/app/protoc-gen-connect-kotlin.jar" "$@"; done
echo "no JRE in $DIR/usr/lib/jvm" >&2
exit 127
EOF
