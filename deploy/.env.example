# EasyP API Service — Environment Variables
# Copy to .env and uncomment the values you need.

# Everything named after the config sections below (DB_, REGISTRY_, SERVER_,
# AUTH_, AUDIT_, RATE_LIMIT_, WORKER_POOL_, LICENSE_, TELEMETRY_) overrides the
# matching field in deploy/config/config.yml. Leaving one empty is the same as
# not setting it, so the file keeps its value.
#
# To see what the two layers actually resolve to, and which of them supplied
# each value, without starting anything:
#
#   easyp-svc config print --cfg deploy/config/config.yml --origin
#   easyp-svc config validate --cfg deploy/config/config.yml
#
# Note that config.yml states only what differs from the defaults compiled into
# the binary; `config print` without --changed shows the rest too.

# --- Ports (docker-compose) ---
# EASYP_TRAEFIK_PORT=4043
# EASYP_TRAEFIK_TLS_PORT=4443
# EASYP_GRAFANA_PORT=3000
# EASYP_POSTGRES_PORT=5432
# The gRPC port is intentionally absent: the service is reached through traefik
# on EASYP_TRAEFIK_TLS_PORT, which is the only holder of a client certificate.
# EASYP_METRICS_PORT=8081
# EASYP_HEALTH_PORT=8082
# EASYP_MCP_PORT=8083

# --- Write token ---
# EASYP_TOKEN is the credential the CLI presents, so `easyp-svc plugins publish`
# does not need it on the command line. It is not a server setting.
# EASYP_TOKEN=
#
# AUTH_WRITE_TOKENS is the server side: the digests permitted to call
# CreatePlugin/UpdatePlugin/DeletePlugin, as "ci=<64 hex>,me=<64 hex>". It
# replaces auth.write_tokens in deploy/config/config.yml, which ships the digest
# of the literal "local-dev-token" so the stack works out of the box — published
# in this repository and therefore worthless as a secret. Set this before the
# stack goes anywhere a stranger can reach.
# Generate a pair with: easyp-svc auth new-token --name ci
# AUTH_WRITE_TOKENS=

# --- Database ---
# deploy/config/config.yml points at the postgres container with a demo password
# that is committed alongside it. Override it to reach a database whose
# credentials are not in git.
# DB_POSTGRES_DSN=postgres://user:pass@host:5432/easyp?sslmode=require

# --- Binary storage ---
# deploy/config/config.yml points at the rustfs container of the dev stack. To read plugin
# archives from a remote S3-compatible store instead, override it here; the
# same credentials are what `easyp-svc plugins publish` needs to write there.
# REGISTRY_S3_ENDPOINT=https://storage.example.com
# REGISTRY_S3_BUCKET=easyp-plugins
# REGISTRY_S3_REGION=us-east-1
# REGISTRY_S3_FORCE_PATH_STYLE=true
# REGISTRY_S3_ACCESS_KEY_ID=
# REGISTRY_S3_SECRET_ACCESS_KEY=

# --- Telemetry ---
# The service also reads the standard OTEL_EXPORTER_OTLP_ENDPOINT when
# TELEMETRY_OTLP_ENDPOINT is unset. The service name is fixed in the binary and
# is not configurable.
# TELEMETRY_OTLP_ENDPOINT=easyp-alloy:4317
# TELEMETRY_PYROSCOPE_ENDPOINT=http://easyp-pyroscope:4040

# --- Enterprise License (uncomment a key and the token to enable) ---
# Verification keys, as "<kid>:<hex>" pairs separated by commas. The key id in
# the token's footer picks one; two entries at once is how a signing key gets
# rotated. Also settable as license.public_keys in deploy/config/config.yml.
# The pair below is the key easyp-tech signs with — the same one the Helm chart
# ships in deploy/charts/easyp-service/values.yaml.
# LICENSE_PUBLIC_KEYS=2026-08:81322461987167d5cfd529e9cb8b96f4797f12fce6be4399a0866e250c9b6bb5
# The PASETO v4.public token itself. It is a credential, so it is not committed
# anywhere: take it from your own licence issuance, or for easyp-tech's own
# deployments from the licences repository under issued/<customer>/.
# LICENSE_KEY=
